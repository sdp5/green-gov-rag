# GreenGovRAG Environment Configuration
# Copy this file to .env and fill in your values

# =========================================================================
# Cloud Storage Settings
# =========================================================================
CLOUD_PROVIDER=local  # Options: local, aws, azure
CLOUD_REGION=  # Optional: Cloud region
STORAGE_CONTAINER=greengovrag-documents
LOCAL_STORAGE_PATH=./data/storage

# AWS Settings (if using AWS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Azure Settings (if using Azure)
AZURE_STORAGE_CONNECTION_STRING=

# =========================================================================
# LLM & Embedding Settings
# =========================================================================
OPENAI_API_KEY=
LLM_MODEL=openai/text-davinci-003
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
BEDROCK_MODEL_ID=

# =========================================================================
# Application Settings
# =========================================================================
APP_ENV=development  # Options: development, staging, production
DEBUG=false
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# =========================================================================
# Database Settings
# =========================================================================
DATABASE_URL=

# =========================================================================
# Vector Store Settings
# =========================================================================
VECTOR_STORE_TYPE=faiss  # Options: faiss, qdrant, chromadb
VECTOR_STORE_PATH=./data/vector_store
QDRANT_URL=
QDRANT_API_KEY=

# =========================================================================
# RAG Settings
# =========================================================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
TOP_K_RESULTS=4

# =========================================================================
# API Settings
# =========================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

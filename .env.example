# Cloud Provider Configuration
# Supported values: aws, azure, local
CLOUD_PROVIDER=local

# Cloud Region/Location
# AWS: us-east-1, ap-southeast-2, etc.
# Azure: australiaeast, eastus, etc.
CLOUD_REGION=ap-southeast-2

# Storage Configuration
STORAGE_CONTAINER=greengovrag-documents

# AWS Configuration (if CLOUD_PROVIDER=aws)
# AWS credentials should be configured via AWS CLI or IAM roles
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_DEFAULT_REGION=ap-southeast-2

# Azure Configuration (if CLOUD_PROVIDER=azure)
# Get this from Azure Portal -> Storage Account -> Access keys
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net

# Local Storage Configuration (if CLOUD_PROVIDER=local)
LOCAL_STORAGE_PATH=./data/storage

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/greengovrag

# Application Configuration
ENV=development
LOG_LEVEL=INFO

# Vector Store Configuration
VECTOR_STORE_PATH=./data/vector_store/faiss.index
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_PROVIDER=huggingface

# RAG Configuration
RAG_TOP_K=5
RAG_LLM_PROVIDER=openai
RAG_LLM_MODEL=gpt-4

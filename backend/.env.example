# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/greengovrag

# LLM Provider (openai, azure, bedrock, anthropic)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# API Keys
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# AWS Bedrock
BEDROCK_MODEL_ID=

# Redis (optional - for caching)
REDIS_URL=redis://localhost:6379

# Vector Store
QDRANT_URL=http://localhost:6333
VECTOR_STORE_TYPE=faiss
VECTOR_STORE_PATH=./data/vector_store

# RAG Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
TOP_K_RESULTS=4

# Cloud Storage
CLOUD_PROVIDER=local
CLOUD_REGION=
STORAGE_CONTAINER=greengovrag-documents
LOCAL_STORAGE_PATH=./data/storage

# CORS Origins (comma-separated for production)
CORS_ORIGINS=http://localhost:3000

# Environment
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Cache Settings (LLM Response Caching)
ENABLE_CACHE=true                          # Enable in-memory + optional Redis caching
ENABLE_REDIS_CACHE=false                   # Enable Redis for distributed/persistent cache
REDIS_HOST=localhost                       # Redis server host
REDIS_PORT=6379                            # Redis server port
CACHE_TTL=3600                             # Cache time-to-live in seconds (default: 1 hour)
ENABLE_SEMANTIC_CACHE=true                 # Enable semantic similarity matching (production-ready, threshold: 0.95)

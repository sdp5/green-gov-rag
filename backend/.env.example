# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/greengovrag

# ===========================================================================
# LLM Provider Configuration
# ===========================================================================
# Options: openai, azure, bedrock, anthropic
LLM_PROVIDER=azure

# LLM Model (depends on provider)
# Azure: gpt-5-mini (recommended), gpt-5, gpt-4o
# AWS Bedrock: us.amazon.nova-pro-v1:0
LLM_MODEL=gpt-5-mini

# Embedding Model Configuration
# NOTE: BGE-large requires ~2GB RAM but provides 93% retrieval accuracy
# Alternatives:
#   - sentence-transformers/all-mpnet-base-v2 (768 dims, 90% accuracy, 1GB RAM)
#   - sentence-transformers/all-MiniLM-L6-v2 (384 dims, 85% accuracy, 512MB RAM)
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# ===========================================================================
# API Keys (REQUIRED: Set at least ONE based on LLM_PROVIDER)
# ===========================================================================
# OpenAI (if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Anthropic (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# AWS Bedrock (if LLM_PROVIDER=bedrock)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
# Bedrock embedding model (optional, uses HuggingFace BGE-large by default)
# BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Azure OpenAI (if LLM_PROVIDER=azure) - RECOMMENDED
# GPT-5-mini: Best performance-to-cost ratio (~5% hallucination, $4/mo for typical usage)
# GPT-5: Maximum accuracy for complex regulatory queries (1.6% hallucination, $21/mo for typical usage)
# Note: GPT-5-mini retirement date - August 8, 2026
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Azure embedding deployment (optional, uses HuggingFace BGE-large by default)
# AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# GitHub Repository
GITHUB_REPO_URL=https://github.com/sdp5/green-gov-rag

# Redis (optional - for caching)
REDIS_URL=redis://localhost:6379

# Vector Store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
VECTOR_STORE_TYPE=qdrant
VECTOR_STORE_PATH=./data/vector_store

# RAG Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
TOP_K_RESULTS=4

# Cloud Storage
CLOUD_PROVIDER=local
CLOUD_REGION=
STORAGE_CONTAINER=greengovrag-documents
LOCAL_STORAGE_PATH=./data/storage

# CORS Origins (comma-separated for production)
CORS_ORIGINS=http://localhost:3000

# Environment
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Validation (NOTE: Do not set SKIP_VALIDATION=true in production)
# SKIP_VALIDATION=false

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# API Security (REQUIRED in production)
# Generate a secure random key: openssl rand -hex 32
# API_ACCESS_KEY: Required for all /api/* endpoints (except /api/health)
API_ACCESS_KEY=dev-insecure-key-change-in-prod

# ADMIN_API_KEY: Required for all /api/admin/* endpoints (must be different from API_ACCESS_KEY)
# Leave empty to use API_ACCESS_KEY for admin routes (not recommended for production)
ADMIN_API_KEY=dev-admin-key-change-in-prod

# Cache Settings (LLM Response Caching)
ENABLE_CACHE=true
ENABLE_REDIS_CACHE=false
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL=3600
ENABLE_SEMANTIC_CACHE=true

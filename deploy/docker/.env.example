# Database
POSTGRES_DB=greengovrag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Vector Store
# Options: faiss, qdrant, chromadb
VECTOR_STORE_TYPE=qdrant
QDRANT_URL=http://qdrant:6333

# API Keys
OPENAI_API_KEY=sk-your-key-here

# LLM Settings
LLM_PROVIDER=openai
LLM_MODEL=gpt-4

# Cache Settings (Production)
ENABLE_CACHE=true                          # Enable LLM response caching
ENABLE_REDIS_CACHE=true                    # Enable Redis for production
REDIS_HOST=redis                           # Redis container name
REDIS_PORT=6379
CACHE_TTL=3600                             # 1 hour cache TTL
ENABLE_SEMANTIC_CACHE=true                 # Enable semantic similarity matching

# CORS (for production)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Environment
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

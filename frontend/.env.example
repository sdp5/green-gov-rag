VITE_API_URL=http://localhost:8000/api

# API Access Key (required for local development)
# Must match API_ACCESS_KEY in backend/.env
# In production, CloudFront (AWS) or Front Door (Azure) injects this header automatically
VITE_API_ACCESS_KEY=dev-insecure-key-change-in-production

VITE_MAPBOX_TOKEN=your_mapbox_token_here
VITE_GITHUB_REPO_URL=https://github.com/sdp5/green-gov-rag
